# Copiar a .env y completar. Nunca commitear .env real (ver .gitignore).
# Usado por docker-compose.yml para levantar Postgres/backend/n8n localmente.
# El detalle y el porqué de cada variable está en docs/backend-plan.md (secciones 10 y 14.5).

# --- Base de datos (local/docker-compose) ---
DB_NAME=korofin
DB_USER=korofin
DB_PASSWORD=changeme
DB_PORT_EXTERNAL=5432

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=America/Bogota

# JWT (requeridas)
JWT_SECRET=changeme-usar-un-secreto-largo-y-aleatorio
JWT_ISSUER=korofin-backend
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# IA (todas opcionales — un proveedor se activa solo si su API key no está vacía)
AI_PROVIDER_PRIORITY=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
AI_MONTHLY_MESSAGE_LIMIT=5
AI_READ_TIMEOUT_SECONDS=60

# Email (opcional, degrada a notificaciones solo in-app si falta)
RESEND_API_KEY=
MAIL_FROM=

# Telegram (opcional — vacío = integración apagada)
TELEGRAM_WEBHOOK_SECRET=

# --- n8n (orquestación del canal Telegram, opcional para desarrollo local) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme
N8N_ENCRYPTION_KEY=changeme-usar-un-secreto-largo-y-aleatorio
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=
